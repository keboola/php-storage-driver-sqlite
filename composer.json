{
    "name": "keboola/storage-driver-sqlite",
    "description": "Keboola SQLite driver",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Keboola",
            "email": "devel@keboola.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Keboola\\StorageDriver\\Sqlite\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Keboola\\StorageDriver\\FunctionalTests\\": "tests/functional",
            "Keboola\\StorageDriver\\UnitTests\\": "tests/unit"
        }
    },
    "require": {
        "php": "^8.2",
        "ext-pdo": "*",
        "ext-sqlite3": "*",
        "aws/aws-sdk-php": "^3.0",
        "google/protobuf": "^3.21",
        "keboola/php-datatypes": "^7.0",
        "keboola/storage-driver-common": "^7.8.0",
        "keboola/table-backend-utils": ">=2.8.0",
        "psr/log": "^1.1|^2.0|^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "phpstan/phpstan": "^1.8",
        "phpstan/phpstan-phpunit": "^1.1",
        "keboola/coding-standard": "^15.0",
        "php-parallel-lint/php-parallel-lint": "^1.3"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "lock": false
    },
    "scripts": {
        "phplint": "parallel-lint --exclude vendor .",
        "phpcs": "phpcs --extensions=php src tests",
        "phpcbf": "phpcbf --extensions=php src tests",
        "phpstan": "phpstan analyse --no-progress",
        "tests-unit": "phpunit --colors=always --testsuite unit",
        "tests-functional": "phpunit --colors=always --testsuite functional",
        "tests": [
            "@tests-unit",
            "@tests-functional"
        ],
        "check": [
            "@composer validate --no-check-all --strict",
            "@phplint",
            "@phpcs",
            "@phpstan"
        ],
        "ci": [
            "@check",
            "@tests-unit"
        ]
    }
}
